<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TLD_ModBlueprintFinder</RootNamespace>
    <AssemblyName>TLD_ModBlueprintFinder</AssemblyName>
    <Version>1.1.0</Version>
    <Product>TLD Mod Blueprint Finder</Product>
    <Description>《漫漫长夜》Mod 配方检索工具：输入物品 ID，双向列出产物 / 原料 / 工具三类蓝图（只读）</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    说明：本工具刻意不引入任何第三方依赖。
    参考实现 ModComponentExtractor 使用 ICSharpCode.SharpZipLib 的 FastZip 把
    .modcomponent 解压到磁盘；本工具只需要「读」，因此改用 BCL 的 System.IO.Compression.ZipArchive
    直接在内存中枚举条目，避免在用户 Mods 目录里产生任何临时文件（不修改游戏文件）。
  -->

</Project>
