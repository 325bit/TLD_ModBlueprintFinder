<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TLD_ModBlueprintFinder</RootNamespace>
    <AssemblyName>TLD_ModBlueprintFinder</AssemblyName>
    <Version>1.5.1</Version>
    <Product>TLD Mod Blueprint Finder</Product>
    <Description>《漫漫长夜》Mod 配方检索工具：输入物品 ID，按蓝图 / 食谱分别列出产物、原料，并单列工具，贴出该物品在 auto-mapped 里的 JSON 定义，并支持备份、就地修改，以及按 modcomponent 增删改查其中的 JSON 文件</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    No third-party dependencies, on purpose. The reference implementation (ModComponentExtractor)
    unpacks .modcomponent to disk with SharpZipLib FastZip; this tool only reads, so it enumerates
    entries in memory with BCL System.IO.Compression.ZipArchive and never leaves a temp file behind
    in the player's Mods folder. Rationale: docs/DEVELOPMENT.md §4.
  -->

</Project>
