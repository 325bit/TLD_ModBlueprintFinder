<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件自包含发布：产物是一个 exe，双击即可运行，目标机器不需要装 .NET。
  用法（三种等价）：
    dotnet publish TLD_ModBlueprintFinder -p:PublishProfile=SelfContainedSingleFile
    Visual Studio 右键工程 → 发布 → 选本配置
    仓库根目录双击 publish.bat
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- 产物直接落到仓库根目录的 dist\ 下，方便拿去分发（相对本工程目录） -->
    <PublishDir>..\dist\</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 关键三项：自带运行时 + 打成单文件 + 原生库也塞进包里 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 压缩后体积大约减半，代价是启动时多解压几百毫秒 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 不裁程序集：WinForms 不支持裁剪 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- 不生成独立 pdb，保证 dist 里只有一个文件 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
