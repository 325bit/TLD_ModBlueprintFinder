<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file self-contained publish: the artifact is one exe that runs on double-click, and the
  target machine needs no .NET installed. Three equivalent ways to run it:
    dotnet publish TLD_ModBlueprintFinder -p:PublishProfile=SelfContainedSingleFile
    Visual Studio: right-click the project -> Publish -> pick this profile
    publish.bat at the repository root
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- Output lands in dist\ at the repository root, relative to the project folder -->
    <PublishDir>..\dist\</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- The three settings that matter: runtime included, one file, native libraries packed too -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Roughly halves the size, at the cost of a few hundred ms of extraction on startup -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- No trimming: WinForms does not support it -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- No separate pdb, so dist\ holds exactly one file -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
